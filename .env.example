# Configuración de StreamLab. Copia este archivo a ".env" y ajusta los valores.

# Puerto de la web (en producción/EC2 se usa 80)
PORT=3000

# Puerto RTMP donde OBS publica el video
RTMP_PORT=1935

# IP o dominio público que se muestra en el panel para OBS.
# Déjalo vacío para usar el host con el que se abre la web.
PUBLIC_HOST=

# Ruta de ffmpeg.
# Windows: usa la salida de:  cygpath -m "$(which ffmpeg)"
# Linux/EC2: /usr/bin/ffmpeg
FFMPEG_PATH=

# Grabar cada transmisión como VOD .mp4 (true/false)
RECORD_VOD=true

# --- Opcionales para muchos espectadores (ver DEPLOY.md, "Prueba de carga") ---
# Rondas de bcrypt (por defecto 10, como pide SPEC.md). Bajarlas a 8 acelera ×4 los registros masivos.
# BCRYPT_ROUNDS=10
# Hilos de trabajo para bcrypt (por defecto: entre 2 y 4 según los núcleos)
# BCRYPT_WORKERS=2
# Puerto interno HTTP de node-media-server (por defecto 8000) y carpetas de datos/video
# NMS_HTTP_PORT=8000
# DATA_DIR=./data
# MEDIA_DIR=./media
